# =============================================================================
# NVIDIA Course Advisor - Environment Configuration Template
# =============================================================================
# Copy this file to .env and customize for your environment
# DO NOT commit .env to version control!

# =============================================================================
# Flask Settings
# =============================================================================
# REQUIRED: Generate a secure key with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secure-secret-key-here

# Set to False in production
FLASK_DEBUG=False

# Server binding
FLASK_HOST=0.0.0.0
FLASK_PORT=5000

# =============================================================================
# Session Settings
# =============================================================================
# How long sessions remain valid (in days)
SESSION_LIFETIME_DAYS=7

# Set to True when using HTTPS in production
SESSION_COOKIE_SECURE=True

# =============================================================================
# Database Settings
# =============================================================================
# Path to SQLite database (use absolute path in production)
# DATABASE_PATH=/path/to/nvidia_courses.db

# =============================================================================
# Ollama / LLM Settings
# =============================================================================
OLLAMA_API_URL=http://localhost:11434
OLLAMA_MODEL=qwen2:7b-instruct-q4_0

# LLM generation parameters
LLM_TEMPERATURE=0.2
LLM_TIMEOUT=120

# =============================================================================
# Embedding Settings
# =============================================================================
EMBEDDING_MODEL=sentence-transformers/all-mpnet-base-v2

# =============================================================================
# RAG Retrieval Settings
# =============================================================================
TOP_K_CHUNKS=6
CHUNK_OVERLAP=2

# =============================================================================
# Security Settings
# =============================================================================
MIN_PASSWORD_LENGTH=8
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# =============================================================================
# Rate Limiting Settings
# =============================================================================
# Enable/disable rate limiting (recommended: True in production)
RATELIMIT_ENABLED=True

# Storage backend
# - Development: memory:// (single server, in-memory storage)
# - Production: redis://localhost:6379 (multi-server, persistent storage)
RATELIMIT_STORAGE_URI=redis://localhost:6379

# Default rate limit for all endpoints
RATELIMIT_DEFAULT=100 per minute

# Specific endpoint rate limits (adjust based on your needs)
RATELIMIT_LOGIN=5 per minute
RATELIMIT_REGISTER=3 per minute
RATELIMIT_CHAT=20 per minute

# =============================================================================
# Gunicorn Production Server Settings
# =============================================================================
# Number of worker processes (recommended formula: 2 * CPU_cores + 1)
# For 4-core server: 9 workers, for 2-core: 5 workers
GUNICORN_WORKERS=9

# Worker class
# - sync: Default, CPU-bound tasks
# - gevent: I/O-bound tasks (recommended for LLM API calls, requires: pip install gevent)
GUNICORN_WORKER_CLASS=gevent

# Request timeout in seconds (must be > LLM_TIMEOUT to avoid killing long requests)
GUNICORN_TIMEOUT=180

# Server binding (0.0.0.0 allows external connections)
GUNICORN_BIND=0.0.0.0:5000

# Logging
# - Use '-' for stdout/stderr
# - Use file path for persistent logs: /var/log/gunicorn/access.log
GUNICORN_ACCESS_LOG=-
GUNICORN_ERROR_LOG=-
GUNICORN_LOGLEVEL=info
