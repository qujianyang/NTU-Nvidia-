{
  "name": "nvidia-learning-desktop",
  "version": "1.0.0",
  "description": "NVIDIA Learning Platform Desktop Application",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build-win": "electron-builder --win",
    "build-portable": "electron-builder --win portable",
    "build-all": "electron-builder -mwl"
  },
  "build": {
    "appId": "com.nvidia.learning.platform",
    "productName": "NVIDIA Learning Platform",
    "directories": {
      "output": "../../dist/desktop"
    },
    "files": [
      "**/*",
      "!**/*.ts",
      "!**/*.map",
      "../pathway-visualizer/dist/**/*",
      "../backend/dist/**/*",
      "../../packages/shared/src/data/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64", "ia32"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "assets/installer.ico",
      "uninstallerIcon": "assets/uninstaller.ico",
      "installerHeaderIcon": "assets/header.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "NVIDIA Learning",
      "license": "LICENSE.txt"
    },
    "portable": {
      "artifactName": "NVIDIA-Learning-Portable-${version}.${ext}"
    },
    "mac": {
      "target": "dmg",
      "icon": "assets/icon.icns",
      "category": "public.app-category.education"
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "icon": "assets/icon.png",
      "category": "Education"
    }
  },
  "dependencies": {
    "electron-store": "^8.1.0",
    "electron-updater": "^6.1.0",
    "sqlite3": "^5.1.0",
    "express": "^4.18.0"
  },
  "devDependencies": {
    "electron": "^27.0.0",
    "electron-builder": "^24.0.0"
  }
}