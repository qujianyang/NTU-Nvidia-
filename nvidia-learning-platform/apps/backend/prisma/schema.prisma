generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Course {
  id              String   @id @default(cuid())
  title           String
  duration        String
  price           String
  type            CourseType
  category        String
  subcategory     String?
  difficulty      Difficulty
  certificate     Boolean
  digitalBadge    Boolean
  description     String?
  role            Role
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  skills          Skill[]
  prerequisites   CoursePrerequisite[] @relation("PrerequisiteCourse")
  requiredFor     CoursePrerequisite[] @relation("RequiredCourse")
  pathCourses     PathCourse[]
  userProgress    UserProgress[]
}

model Skill {
  id        String   @id @default(cuid())
  name      String   @unique
  courses   Course[]
  users     UserSkill[]
}

model CoursePrerequisite {
  id              String @id @default(cuid())
  courseId        String
  prerequisiteId  String
  course          Course @relation("RequiredCourse", fields: [courseId], references: [id])
  prerequisite    Course @relation("PrerequisiteCourse", fields: [prerequisiteId], references: [id])

  @@unique([courseId, prerequisiteId])
}

model LearningPath {
  id            String   @id @default(cuid())
  title         String
  role          Role
  category      String
  description   String
  totalDuration String?
  totalCost     Float?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  courses       PathCourse[]
  savedByUsers  UserSavedPath[]
}

model PathCourse {
  id       String       @id @default(cuid())
  pathId   String
  courseId String
  order    Int
  path     LearningPath @relation(fields: [pathId], references: [id])
  course   Course       @relation(fields: [courseId], references: [id])

  @@unique([pathId, courseId])
}

model User {
  id              String   @id @default(cuid())
  email           String   @unique
  name            String
  role            Role
  budget          Float?
  timeAvailable   String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  skills          UserSkill[]
  targetSkills    UserTargetSkill[]
  progress        UserProgress[]
  savedPaths      UserSavedPath[]
  conversations   Conversation[]
}

model UserSkill {
  id        String   @id @default(cuid())
  userId    String
  skillId   String
  level     SkillLevel
  user      User     @relation(fields: [userId], references: [id])
  skill     Skill    @relation(fields: [skillId], references: [id])

  @@unique([userId, skillId])
}

model UserTargetSkill {
  id        String   @id @default(cuid())
  userId    String
  skillName String
  user      User     @relation(fields: [userId], references: [id])
}

model UserProgress {
  id             String    @id @default(cuid())
  userId         String
  courseId       String
  status         ProgressStatus
  percentComplete Float    @default(0)
  startDate      DateTime?
  completionDate DateTime?
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user           User      @relation(fields: [userId], references: [id])
  course         Course    @relation(fields: [courseId], references: [id])

  @@unique([userId, courseId])
}

model UserSavedPath {
  id        String       @id @default(cuid())
  userId    String
  pathId    String
  savedAt   DateTime     @default(now())
  user      User         @relation(fields: [userId], references: [id])
  path      LearningPath @relation(fields: [pathId], references: [id])

  @@unique([userId, pathId])
}

model Conversation {
  id        String   @id @default(cuid())
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id])
  messages  Message[]
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  role           MessageRole
  content        String
  createdAt      DateTime     @default(now())

  conversation   Conversation @relation(fields: [conversationId], references: [id])
}

enum CourseType {
  SELF_PACED
  INSTRUCTOR_LED
  CERTIFICATION
}

enum Difficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum Role {
  DEVELOPER
  ADMINISTRATOR
  BOTH
}

enum SkillLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT
}

enum ProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}