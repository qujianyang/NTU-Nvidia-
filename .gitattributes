# Set default behavior to automatically normalize line endings to LF
* text=auto eol=lf

# ===== Windows-specific files (keep CRLF) =====
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# ===== Shell scripts (force LF) =====
*.sh text eol=lf
